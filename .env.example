# PowerTrader AI — environment variables
# Copy to .env and fill in your values.  NEVER commit .env to git.

# ── Robinhood Crypto API (required for live trading only) ──────────────
# Generate via pt_hub.py → Settings → Robinhood API → Setup Wizard
ROBINHOOD_API_KEY=
ROBINHOOD_PRIVATE_KEY_BASE64=

# ── Coins to trade (overrides gui_settings.json when set) ─────────────
# Comma-separated.  Must have trained model files in matching sub-dirs.
POWERTRADER_COINS=BTC,ETH,DOGE

# ── Redis IPC (optional) ───────────────────────────────────────────────
# Leave empty to use file-based IPC (default).
# Set to enable sub-100ms signal latency and multi-machine support.
REDIS_URL=redis://redis:6379

# ── Hub data directory ─────────────────────────────────────────────────
# Where trader_status.json, trade_history.jsonl, etc. are written.
# Defaults to ./hub_data when unset.
# POWERTRADER_HUB_DIR=/app/hub_data

# ── Paper trading balance ─────────────────────────────────────────────
# Starting USD balance for paper trading mode.
# PAPER_BALANCE=10000
